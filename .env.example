# Template for live runs only. Copy to .env (gitignored) and fill in.
# Offline tests and `agentmemeval demo` need none of these.

# OpenAI-compatible endpoint used for answering, judging and the agent (M5)
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANSWER_MODEL=
JUDGE_MODEL=

# mem0 arm (M5): only needed for the hosted platform; leave empty for local mem0
MEM0_API_KEY=

# Hugging Face token: only needed if the dataset requires login
HF_TOKEN=
