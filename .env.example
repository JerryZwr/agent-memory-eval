# Template for live runs only. Copy to .env (gitignored) and fill in.
# Offline tests and `agentmemeval demo` need none of these.

# DeepSeek open platform (OpenAI-compatible): answering, judging and the live agent.
# The only key the code reads (src/agentmemeval/llm/openai_compat.py).
DEEPSEEK_API_KEY=

# Hugging Face token: only if the dataset download asks for a login
# (read by huggingface_hub itself, not by this project).
HF_TOKEN=

# The mem0 arm runs locally and needs no key: embeddings come from a local
# Ollama (`ollama pull nomic-embed-text`), storage is a local Qdrant directory.
